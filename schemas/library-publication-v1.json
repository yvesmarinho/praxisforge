{
  "_meta": {
    "criado_em": "25/09/2026 12:59",
    "modificado_em": "2026-09-25T12:59:00-03:00"
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://praxisforge.local/schemas/library-publication-v1.json",
  "title": "Marcador de item publicado pelo praxisforge (v1)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "name",
    "version",
    "content_sha256",
    "source"
  ],
  "properties": {
    "schema_version": {
      "const": "1"
    },
    "kind": {
      "enum": [
        "skill",
        "command",
        "agent",
        "rule"
      ]
    },
    "name": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
      "maxLength": 64
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "content_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "source": {
      "type": "string",
      "pattern": "^library/(skills|commands|agents|rules)/[a-z0-9]+(-[a-z0-9]+)*$"
    }
  }
}

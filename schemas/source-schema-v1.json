{
  "_meta": {
    "criado_em": "21/09/2026 15:59",
    "modificado_em": "2026-09-21T16:01:02-03:00"
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://praxisforge.local/schemas/source-schema-v1.json",
  "title": "Proveniência de fonte curada — frontmatter (v1)",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "origin", "date", "license", "relevance", "status", "extract_allowed"],
  "properties": {
    "schema_version": { "const": "1" },
    "origin": { "type": "string", "minLength": 1, "not": { "pattern": "^(/|[A-Za-z]:\\\\)" } },
    "date": { "type": "string", "format": "date" },
    "license": { "type": "string", "minLength": 1 },
    "relevance": { "type": "string", "minLength": 1 },
    "status": { "enum": ["active", "pending"] },
    "extract_allowed": { "type": "boolean" }
  },
  "allOf": [
    {
      "if": { "properties": { "license": { "const": "unknown" } }, "required": ["license"] },
      "then": { "properties": { "status": { "const": "pending" } } }
    },
    {
      "if": { "properties": { "status": { "const": "pending" } }, "required": ["status"] },
      "then": { "properties": { "extract_allowed": { "const": false } } }
    }
  ]
}

{
  "_meta": {
    "criado_em": "28/09/2026 15:32",
    "modificado_em": "2026-09-28T15:40:00-03:00"
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://praxisforge.local/schemas/curation-draft-response-v1.json",
  "title": "Resposta do modelo de rascunho (v1)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind",
    "name",
    "description",
    "body"
  ],
  "properties": {
    "kind": {
      "enum": [
        "skill",
        "command",
        "agent",
        "hook",
        "rule",
        "reference"
      ]
    },
    "name": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
      "minLength": 3,
      "maxLength": 64
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024,
      "pattern": "\\S"
    },
    "body": {
      "type": "string",
      "minLength": 1,
      "maxLength": 65536,
      "pattern": "\\S"
    }
  }
}

{
  "_meta": {
    "criado_em": "28/09/2026 15:32",
    "modificado_em": "2026-09-28T15:40:00-03:00"
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://praxisforge.local/schemas/curation-draft-schema-v1.json",
  "title": "Rascunho de item do acervo em staging (v1)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "draft_id",
    "proposal",
    "origins",
    "checks",
    "similarity_alert",
    "merge_target",
    "prompt_fingerprint",
    "model",
    "cost_usd",
    "updated_at"
  ],
  "properties": {
    "schema_version": {
      "const": "1"
    },
    "draft_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{16}$"
    },
    "proposal": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "name",
        "description",
        "body"
      ],
      "properties": {
        "kind": {
          "enum": [
            "skill",
            "command",
            "agent",
            "hook",
            "rule",
            "reference"
          ]
        },
        "name": {
          "type": "string",
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
          "minLength": 3,
          "maxLength": 64
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024,
          "pattern": "\\S"
        },
        "body": {
          "type": "string",
          "minLength": 1,
          "maxLength": 65536,
          "pattern": "\\S"
        }
      }
    },
    "origins": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "alias",
          "path",
          "sha256"
        ],
        "properties": {
          "alias": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{1,62}$"
          },
          "path": {
            "type": "string",
            "minLength": 1,
            "pattern": "^(?!/)(?!.*(^|/)\\.\\.(/|$)).+$"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    },
    "checks": {
      "type": "array",
      "minItems": 1,
      "maxItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "structural_score",
          "threshold",
          "judge_is_derivative",
          "judge_justification",
          "flagged"
        ],
        "properties": {
          "structural_score": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "threshold": {
            "type": "number",
            "exclusiveMinimum": 0,
            "maximum": 1
          },
          "judge_is_derivative": {
            "type": "boolean"
          },
          "judge_justification": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000,
            "pattern": "\\S"
          },
          "flagged": {
            "type": "boolean"
          }
        }
      }
    },
    "similarity_alert": {
      "type": "boolean"
    },
    "merge_target": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "ref"
          ],
          "properties": {
            "kind": {
              "const": "library"
            },
            "ref": {
              "type": "string",
              "pattern": "^(skill|command|agent|hook|rule|reference)/[a-z0-9]+(-[a-z0-9]+)*$"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "ref"
          ],
          "properties": {
            "kind": {
              "const": "draft"
            },
            "ref": {
              "type": "string",
              "pattern": "^[0-9a-f]{16}$"
            }
          }
        }
      ]
    },
    "prompt_fingerprint": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "model": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "cost_usd": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "number",
          "minimum": 0
        }
      ]
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}

{
  "_meta": {
    "criado_em": "24/09/2026 15:12",
    "modificado_em": "2026-09-24T15:12:01-03:00"
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://praxisforge.local/schemas/skill-publication-v1.json",
  "title": "Marcador de skill publicada pelo praxisforge (v1)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "name",
    "version",
    "content_sha256",
    "source"
  ],
  "properties": {
    "schema_version": {
      "const": "1"
    },
    "name": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "content_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "source": {
      "type": "string",
      "pattern": "^skills/[a-z0-9]+(-[a-z0-9]+)*$"
    }
  }
}

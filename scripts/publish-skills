# Atalho para `praxisforge skills publish` (feature 008, constituição Princípio VI).
# Repassa todos os argumentos e devolve o mesmo código de saída.
# Uso: scripts/publish-skills <nome>|--all --target global|<pasta-do-projeto> [--mode copy|symlink] [--prune]
set -euo pipefail

cd "$(dirname "${BASH_SOURCE[0]}")/.."
exec uv run praxisforge skills publish "$@"
